#pragma once
//
// Template for include/secrets.h - copy this file to secrets.h and fill in your
// own values. secrets.h is git-ignored so real credentials never get committed.
//

// --- WiFi --------------------------------------------------------------------
#define WIFI_SSID     "your-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// --- MQTT (mosquitto, TLS on 8883, allow_anonymous false) --------------------
#define MQTT_HOST      "192.168.1.10"
#define MQTT_PORT       8883
#define MQTT_CLIENT_ID  "dvs-sniffer"
#define MQTT_USERNAME   "opentherm"
#define MQTT_PASSWORD   "your-mqtt-password"

// Broker CA certificate (PEM). Leave "" to skip broker verification (encrypted but
// unauthenticated - trusted LAN only).
#define MQTT_CA_CERT ""